if nargin < 2 || isempty(ier), ier = 0; end
# FORTRAN qol_clear_patch_levels_mex(uint64_t[1] lv, inout int[1] ier);
end

@function [ier] = qol_clear_patch_levels_all_mex(ier)
if nargin < 1 || isempty(ier), ier = 0; end
# FORTRAN qol_clear_patch_levels_all_mex(inout int[1] ier);
end

@function [R, c, sxbd, swbd, stangbd, sspbd, qhat, Fbd, Fxbd, Fybd, Fzbd, Mmatrix] = qol_build_closepanel_precomp_mex(n, sx, snx, sw, r_vert, nterms, h_dim, nbd, sbdnp, nquad, alpha, exterior, ichart, sxbd_chart, tgl, wgl, Dgl, umatr, R, c, sxbd, swbd, stangbd, sspbd, qhat, Fbd, Fxbd, Fybd, Fzbd, Mmatrix)
n = double(n);
nterms = double(nterms);
h_dim = double(h_dim);
nbd = double(nbd);
sbdnp = double(sbdnp);
nquad = double(nquad);
alpha = double(alpha);
exterior = double(logical(exterior));
ichart = double(ichart);
sx = double(reshape(sx, 3, n));
snx = double(reshape(snx, 3, n));
sw = double(sw(:));
r_vert = double(reshape(r_vert, 3, 3));
sxbd_chart = double(reshape(sxbd_chart, 3, nbd));
nsq = (nterms+1)^2;
mh = 4*h_dim;
tgl = double(reshape(tgl, nquad, 1));
wgl = double(reshape(wgl, nquad, 1));
Dgl = double(reshape(Dgl, nquad, nquad));
umatr = double(reshape(umatr, h_dim, h_dim));
if nargin < 19 || isempty(R), R = zeros(3, 3); end
if nargin < 20 || isempty(c), c = zeros(3, 1); end
if nargin < 21 || isempty(sxbd), sxbd = zeros(3, nbd); end
if nargin < 22 || isempty(swbd), swbd = zeros(nbd, 1); end
if nargin < 23 || isempty(stangbd), stangbd = zeros(3, nbd); end
if nargin < 24 || isempty(sspbd), sspbd = zeros(nbd, 1); end
if nargin < 25 || isempty(qhat), qhat = zeros(3, 1); end
if nargin < 26 || isempty(Fbd), Fbd = complex(zeros(nbd, nsq)); end
if nargin < 27 || isempty(Fxbd), Fxbd = complex(zeros(nbd, nsq)); end
if nargin < 28 || isempty(Fybd), Fybd = complex(zeros(nbd, nsq)); end
if nargin < 29 || isempty(Fzbd), Fzbd = complex(zeros(nbd, nsq)); end
if nargin < 30 || isempty(Mmatrix), Mmatrix = zeros(mh, mh); end
# FORTRAN qol_build_closepanel_precomp_mex(int[1] n, double[3,n] sx, double[3,n] snx, double[n] sw, double[3,3] r_vert, int[1] nterms, int[1] h_dim, int[1] nbd, int[1] sbdnp, int[1] nquad, double[1] alpha, int[1] exterior, int[1] ichart, double[3,nbd] sxbd_chart, double[nquad] tgl, double[nquad] wgl, double[nquad,nquad] Dgl, double[h_dim,h_dim] umatr, inout double[3,3] R, inout double[3] c, inout double[3,nbd] sxbd, inout double[nbd] swbd, inout double[3,nbd] stangbd, inout double[nbd] sspbd, inout double[3] qhat, inout dcomplex[nbd,nsq] Fbd, inout dcomplex[nbd,nsq] Fxbd, inout dcomplex[nbd,nsq] Fybd, inout dcomplex[nbd,nsq] Fzbd, inout double[mh,mh] Mmatrix);
end

@function [Ichi, Ialpha] = qol_build_tc_chialpha_mex(m, r0, nbd, sbdnp, nquad, ncoeff, sxbd, stangbd, sspbd, w1, w3, Fx, Fy, Fz, IalphaAsvestas, Ichi, Ialpha)
m = double(m);
nbd = double(nbd);
sbdnp = double(sbdnp);
nquad = double(nquad);
ncoeff = double(ncoeff);
nsm = sbdnp*m;
nc4 = 4*ncoeff;
r0 = double(reshape(r0, 3, m));
sxbd = double(reshape(sxbd, 3, nbd));
stangbd = double(reshape(stangbd, 3, nbd));
sspbd = double(sspbd(:));
w1 = double(reshape(w1, nquad, nsm));
w3 = double(reshape(w3, nquad, nsm));
Fx = double(reshape(Fx, nbd, ncoeff));
Fy = double(reshape(Fy, nbd, ncoeff));
Fz = double(reshape(Fz, nbd, ncoeff));
IalphaAsvestas = double(IalphaAsvestas(:));
if nargin < 16 || isempty(Ichi), Ichi = complex(zeros(m, nc4)); end
if nargin < 17 || isempty(Ialpha), Ialpha = complex(zeros(m, nc4)); end
# FORTRAN qol_build_tc_chialpha_mex(int[1] m, double[3,m] r0, int[1] nbd, int[1] sbdnp, int[1] nquad, int[1] ncoeff, double[3,nbd] sxbd, double[3,nbd] stangbd, double[nbd] sspbd, double[nquad,nsm] w1, double[nquad,nsm] w3, dcomplex[nbd,ncoeff] Fx, dcomplex[nbd,ncoeff] Fy, dcomplex[nbd,ncoeff] Fz, double[m] IalphaAsvestas, inout dcomplex[m,nc4] Ichi, inout dcomplex[m,nc4] Ialpha);
Ichi = reshape(Ichi, m, ncoeff, 4);
Ialpha = reshape(Ialpha, m, ncoeff, 4);
end
