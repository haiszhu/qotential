% qotential.mw
% mwrap interface for the qotential BIE-solver glue layer.
% Generated mex file: matlab/qotential_mex.<EXT>
%
% Build flags (from top-level Makefile): mwrap -c99complex -i8 -mex
% After generation: perl -pi -e 's/_{2,}/_/g' qotential_mex.c
%
% ============================================================
% mwrap syntax:
%
%   @function [inout1, inout2] = SubroutineName_mex(in1, in2, inout1, inout2)
%   % optional MATLAB pre-processing (reshape etc.)
%   # FORTRAN SubroutineName(type[dims] in1, type[dims] in2, inout type[dims] inout1, inout type[dims] inout2);
%   end
%
% Convention: inout variables appear on BOTH sides of the MATLAB call.
% This keeps Fortran and MATLAB calling sequences exactly the same.
% type keywords: int, double, dcomplex
% dims: [1] scalar, [n] vector, [3,n] array (col-major)
% ============================================================

% --------------------------------------------------------------------------
% qol_lap3ddlp_closepanel_mex
% Close-evaluation Laplace DLP matrix Ac for one tensor-product source patch
% and an arbitrary set of close targets.  Single-precision r64 path.
%
% MATLAB-facing signature:
%   Ac = qol_lap3ddlp_closepanel_mex(t, s, order, ref, if_adapt)
%
% where t.x is (3, m_tgt), s.x is (3, npat), npat = order^2,
% order is the surface tensor order, ref the panel refinement factor.
% if_adapt = true selects the adaptive moments path (currently the only
% one implemented in Lap3dDLP_closepanel_r64).
%
% Output:
%   Ac (m_tgt, npat)  close-eval matrix
% --------------------------------------------------------------------------
@function [Ac] = qol_lap3ddlp_closepanel_mex(t, s, order, ref, if_adapt)
t_x        = double(reshape(t.x, 3, []));
s_x        = double(reshape(s.x, 3, []));
m_tgt      = size(t_x, 2);
npat       = size(s_x, 2);
order      = double(order);
ref        = double(ref);
if_adapt_d = double(logical(if_adapt));
Ac         = zeros(m_tgt, npat);
# FORTRAN qol_lap3ddlp_closepanel_mex(int[1] m_tgt, double[3,m_tgt] t_x, int[1] npat, double[3,npat] s_x, int[1] order, int[1] ref, double[1] if_adapt_d, inout double[m_tgt,npat] Ac);
end

@function [As, Ad, Omega, IalphaAsvestas, timeinfo] = qol_rrq_mex(m, tx, n, sx, snx, sw, rts, rps, order, nquad, orderff, distff, exterior, isimd, ichart, sxbd_chart, rv_chart, tgl, wgl, Dgl, w_bclag, Legmat, umatr, vmatr, As, Ad, Omega, IalphaAsvestas, timeinfo)
m       = double(m);
n       = double(n);
order   = double(order);
nquad   = double(nquad);
orderff = double(orderff);
isimd   = double(isimd);
distff  = double(distff);
exterior = double(logical(exterior));
tx  = double(reshape(tx,  3, m));
sx  = double(reshape(sx,  3, n));
snx = double(reshape(snx, 3, n));
rts = double(reshape(rts, 3, n));
rps = double(reshape(rps, 3, n));
sw  = double(sw(:));
h_dim = order*(order+1)/2;
if nargin < 25 || isempty(As), As = zeros(m, n); end
if nargin < 26 || isempty(Ad), Ad = zeros(m, n); end
if nargin < 27 || isempty(Omega), Omega = zeros(4*h_dim, m); end
if nargin < 28 || isempty(IalphaAsvestas), IalphaAsvestas = zeros(m, 1); end
if nargin < 29 || isempty(timeinfo), timeinfo = zeros(20, 1); end
nbd = 3*nquad;
ichart = double(ichart);
sxbd_chart = double(reshape(sxbd_chart, 3, nbd));
rv_chart   = double(reshape(rv_chart, 3, 3));
tgl = double(reshape(tgl, nquad, 1));
wgl = double(reshape(wgl, nquad, 1));
Dgl = double(reshape(Dgl, nquad, nquad));
w_bclag = double(reshape(w_bclag, nquad, 1));
Legmat = double(reshape(Legmat, nquad, nquad));
umatr = double(reshape(umatr, h_dim, h_dim));
vmatr = double(reshape(vmatr, h_dim, h_dim));
mh = 4*h_dim;
# FORTRAN qol_rrq_mex(int[1] m, double[3,m] tx, int[1] n, double[3,n] sx, double[3,n] snx, double[n] sw, double[3,n] rts, double[3,n] rps, int[1] order, int[1] nquad, int[1] orderff, double[1] distff, int[1] exterior, int[1] isimd, int[1] ichart, double[3,nbd] sxbd_chart, double[3,3] rv_chart, double[nquad] tgl, double[nquad] wgl, double[nquad,nquad] Dgl, double[nquad] w_bclag, double[nquad,nquad] Legmat, double[h_dim,h_dim] umatr, double[h_dim,h_dim] vmatr, inout double[m,n] As, inout double[m,n] Ad, inout double[mh,m] Omega, inout double[m] IalphaAsvestas, inout double[20] timeinfo);
end

@function [tgl, wgl, Dgl, w_bclag, Legmat, umatr, vmatr] = qol_simplex_precomp_mex(nquad, korder, kpols, tgl, wgl, Dgl, w_bclag, Legmat, umatr, vmatr)
nquad = double(nquad);
korder = double(korder);
kpols = double(kpols);
if nargin < 4 || isempty(tgl), tgl = zeros(nquad, 1); end
if nargin < 5 || isempty(wgl), wgl = zeros(nquad, 1); end
if nargin < 6 || isempty(Dgl), Dgl = zeros(nquad, nquad); end
if nargin < 7 || isempty(w_bclag), w_bclag = zeros(nquad, 1); end
if nargin < 8 || isempty(Legmat), Legmat = zeros(nquad, nquad); end
if nargin < 9 || isempty(umatr), umatr = zeros(kpols, kpols); end
if nargin < 10 || isempty(vmatr), vmatr = zeros(kpols, kpols); end
# FORTRAN qol_simplex_precomp_mex(int[1] nquad, int[1] korder, int[1] kpols, inout double[nquad] tgl, inout double[nquad] wgl, inout double[nquad,nquad] Dgl, inout double[nquad] w_bclag, inout double[nquad,nquad] Legmat, inout double[kpols,kpols] umatr, inout double[kpols,kpols] vmatr);
end

@function [lv, ier] = qol_build_patch_levels_mex(korder, npols, sx, rts, rps, order, dist, nlevel, lv, ier)
korder = double(korder);
npols = double(npols);
order = double(order);
nlevel = double(nlevel);
dist = double(dist);
sx = double(reshape(sx, 3, npols));
rts = double(reshape(rts, 3, npols));
rps = double(reshape(rps, 3, npols));
if nargin < 9 || isempty(lv), lv = 0; end
if nargin < 10 || isempty(ier), ier = 0; end
# FORTRAN qol_build_patch_levels_mex(int[1] korder, int[1] npols, double[3,npols] sx, double[3,npols] rts, double[3,npols] rps, int[1] order, double[1] dist, int[1] nlevel, inout uint64_t[1] lv, inout int[1] ier);
end

@function [As, Ad, idxs, ms, ier] = qol_lap3dsdlpmat_levels_mex(m, tx, npols, lv, isimd, As, Ad, idxs, ms, ier)
m = double(m);
npols = double(npols);
lv = double(lv);
isimd = double(isimd);
tx = double(reshape(tx, 3, m));
if nargin < 6 || isempty(As), As = zeros(m, npols); end
if nargin < 7 || isempty(Ad), Ad = zeros(m, npols); end
if nargin < 8 || isempty(idxs), idxs = zeros(m, 1); end
if nargin < 9 || isempty(ms), ms = 0; end
if nargin < 10 || isempty(ier), ier = 0; end
# FORTRAN qol_lap3dsdlpmat_levels_mex(int[1] m, double[3,m] tx, int[1] npols, uint64_t[1] lv, int[1] isimd, inout double[m,npols] As, inout double[m,npols] Ad, inout int[m] idxs, inout int[1] ms, inout int[1] ier);
end

@function [ier] = qol_clear_patch_levels_mex(lv, ier)
